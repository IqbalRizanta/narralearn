# ---------------------------------------------------------------------------
# NarraLearn AI — environment template
# Copy to .env and change secrets. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ENABLE_DOCS=true
FRONTEND_URL=http://localhost:5173

# Database / queue — demo default needs no PostgreSQL or Redis.
DATABASE_URL=sqlite+aiosqlite:///./narralearn.db
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=inline
AUTO_CREATE_TABLES=true
# Production: use PostgreSQL + ARQ and run Alembic migrations.
# DATABASE_URL=postgresql+asyncpg://narralearn:narralearn@localhost:5432/narralearn
# QUEUE_MODE=arq
# AUTO_CREATE_TABLES=false

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Uploads
UPLOAD_DIR=var/uploads
MAX_AUDIO_MB=100
MAX_DOCUMENT_MB=25
MAX_PDF_PAGES=100
MAX_PPTX_SLIDES=200
MAX_DOCUMENT_CHARS=300000

# AI / ML providers
# mock | gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=90

# mock | faster_whisper
STT_PROVIDER=mock
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# heuristic | speechbrain
VOICE_PROVIDER=heuristic
VOICE_READY_THRESHOLD=85
SPEAKER_SIMILARITY_THRESHOLD=0.65
VOICE_MODEL_DIR=var/models/speechbrain

# Limits / security
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
MAX_CONTEXT_CHARS=120000
TEMP_RETENTION_HOURS=24

# Frontend (Vite)
VITE_API_BASE=/api/v1
